; Embeds the whole data/ catalog plus the demo alpha as string constants
; (the browser has no filesystem). Generator adapted from app/ui/client.

(rule
 (targets embedded_data.ml)
 (deps
  gen_embedded_data.sh
  (:alpha ../../examples/demo_alpha_tsla.csv)
  (source_tree ../../data))
 (action
  (with-stdout-to
   embedded_data.ml
   (run bash gen_embedded_data.sh ../../data %{alpha}))))
